#!/usr/bin/env bash
# Universal Color GNN study launcher (run inside the study container).
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_dir"
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTHONUNBUFFERED=1
exec "$repo_dir/.venv/bin/python" -m dcl.universal.cli "$@"
