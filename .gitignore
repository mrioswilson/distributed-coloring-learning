paper/ucgnn/*.aux
paper/ucgnn/*.bbl
paper/ucgnn/*.blg
paper/ucgnn/*.out
paper/ucgnn/*.synctex.gz

# Generated Python packaging metadata
*.egg-info/

# Neural network checkpoints
*.pt
*.pth
*.ckpt

# Reproducible study runtime (plans and source remain versioned)
data/m6study*/

# Universal Color GNN runtime (plans and source remain versioned)
data/ucgnn*/

# Native multi-teacher comparison runtime
data/multiteacher*/

# E1 behavior comparison and reproduction runtime
data/e1-behavior*/
data/e1-retrained*/

# Independent integration runtime; reviewed outcomes are exported to results/.
data/integration*/

# PDF review renders are reproducible from the published PDF and build script.
results/integration/paper-review/

# Query-budgeted study runtime, separate from the historical 70 checkpoints.
data/sample-complexity*/
results/sample-complexity/paper-review/*
!results/sample-complexity/paper-review/all-pages.png

# Local frozen degree runtime: raw rows and exact-reference tapes are included
# in the authenticated local bundle; summaries, traces and hashes are versioned.
results/multiteacher-degree-generalization/**/rows.json
results/multiteacher-degree-generalization/**/exact/**/r*.json
results/multiteacher-degree-generalization/paper-review/
